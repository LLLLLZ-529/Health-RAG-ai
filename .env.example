# ===== HealthRAG（开发版）环境配置 =====
# 复制本文件为 .env 后填写；.env 已被 .gitignore 忽略，切勿提交

# --- 基础 ---
APP_NAME=HealthRAG
APP_VERSION=1.0.0
DEBUG=0
RUN_ENV=
DATA_ROOT=

# --- 数据库（本地默认 SQLite）---
DATABASE_URL=sqlite:///./healthrag.db

# --- 数据路径（默认是 Windows 路径，macOS/Linux 必须覆盖）---
DATA_DIR=./data
KNOWLEDGE_DIR=./knowledge/chunks
VECTOR_STORE_DIR=./data/vector_store

# --- RAG 开关 ---
USE_DENSE=0
USE_RERANKER=0
BM25_TOP_K=30
DENSE_TOP_K=10
RERANK_TOP_K=5
HYBRID_ALPHA=0.5
EMBED_MODEL=BAAI/bge-large-zh-v1.5
RERANK_MODEL=BAAI/bge-reranker-large

# --- LLM（provider 三选一：dashscope / openai / deepseek）---
LLM_PROVIDER=dashscope
LLM_MODEL=qwen-plus
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- COS（仅 SCF/云函数部署需要）---
COS_BUCKET=
COS_REGION=
COS_KNOWLEDGE_PREFIX=chunks/
COS_SECRET_ID=
COS_SECRET_KEY=
COS_TOKEN=

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
